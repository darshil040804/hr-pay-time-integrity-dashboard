# Copy this file to .env and paste your real key into .env.
# Never commit .env. Only this example file belongs in the repo.

# Groq (free tier: console.groq.com -> API Keys)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Alternative Groq model (stronger reasoning, may be slower):
# AI_MODEL=openai/gpt-oss-120b

# Pause between AI requests (seconds) to stay under free-tier rate limits
AI_REQUEST_DELAY_SECONDS=3